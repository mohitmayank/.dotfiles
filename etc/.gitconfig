[user]
  email = mayank.mohit@gmail.com
  name = Mohit
[credential]
  helper = cache --timeout 2880000
[push]
  default = current
[core]
  excludesfile = ~/.gitignore
  fileMode = true
  filemode = false
  filemode = true
	attributesfile = ~/.gitattributes
[diff]
  tool = meld
[merge]
  tool = meld
  conflictstyle = diff3
[mergetool]
  prompt = true
[credential]
  helper = cache --timeout=36000
[difftool]
  tool = vimdiff
  prompt = true
[alias]
  a = add
  d = difftool
  dm = "difftool --diff-filter=M"
  nfm = "!f(){ git -c core.fileMode=false $@; };f"
  s = status
  m = merge
  b = branch
  c = commit
  p = push
  f = pull
  co = checkout
  mt = mergetool
  A = "add -A"
  cm = "commit -m"
  gl = "log --graph --oneline --decorate --all"
  create-pull-request = !sh -c 'stash pull-request $0 $@'
	diff-image = "!f() { cd -- \"${GIT_PREFIX:-.}\"; GIT_DIFF_IMAGE_ENABLED=1 git diff \"$@\"; }; f"

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[init]
	defaultBranch = main
[diff "image"]
	command = /home/files/bin/git-diff-image/git_diff_image

# Machine-specific overrides (e.g. work email) live outside the repo, so they're never tracked.
[include]
  path = ~/.gitconfig.local
